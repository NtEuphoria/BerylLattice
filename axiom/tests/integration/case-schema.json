{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Axiom independent Core correspondence manifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "artifact_kind",
    "plans",
    "lanes",
    "cases"
  ],
  "properties": {
    "schema_version": {
      "const": 1
    },
    "artifact_kind": {
      "const": "core_correspondence_manifest"
    },
    "plans": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "enum": [
          "inline-v1",
          "materialize-v1",
          "rows2-v1"
        ]
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "lane",
          "release"
        ],
        "properties": {
          "lane": {
            "enum": [
              "reference",
              "ast",
              "ir"
            ]
          },
          "release": {
            "type": "boolean"
          }
        }
      }
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "case_id",
          "shape",
          "pattern",
          "source_utf8",
          "source_sha256",
          "input",
          "initial_output"
        ],
        "properties": {
          "case_id": {
            "type": "string",
            "minLength": 1
          },
          "shape": {
            "type": "array",
            "items": {
              "type": "integer",
              "minimum": 1
            },
            "minItems": 2,
            "maxItems": 2
          },
          "pattern": {
            "type": "string",
            "minLength": 1
          },
          "source_utf8": {
            "type": "string",
            "minLength": 1
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "input": {
            "$ref": "#/$defs/i32_vector"
          },
          "initial_output": {
            "$ref": "#/$defs/i32_vector"
          }
        }
      }
    }
  },
  "$defs": {
    "i32_vector": {
      "type": "array",
      "items": {
        "type": "integer",
        "minimum": -2147483648,
        "maximum": 2147483647
      }
    }
  }
}
