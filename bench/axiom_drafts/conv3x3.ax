// 3x3 convolution [1 2 1; 2 4 2; 1 2 1] written separably: weighted row
// pass [1 2 1], then weighted column pass [1 2 1]. Same integers as the
// direct nine-tap form. With >= 3 rows of scratch the planner reuses rows.
module conv3x3;
shape H = 14;
shape W = 14;
input g: i32[H+2,W+2] in 0..=1023;
let t[r in 0..H+2,c in 0..W] = (g[r,c]+2*g[r,c+1])+g[r,c+2];
output o[r in 0..H,c in 0..W] = (t[r,c]+2*t[r+1,c])+t[r+2,c];
require plan_workspace_bytes <= 1024;
prefer multiplication_ops;
